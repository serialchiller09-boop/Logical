# Logical deployment settings
#
# Hosting providers normally set these in their dashboard, not from this file.
# Copy this to .env only for local experiments if you also load it yourself.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# REQUIRED when exposed to other people. The default development token is logical-admin.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Use a persistent mounted disk/volume in production so bookmarks, notes, and plant edits survive redeploys.
# If omitted, Logical writes to server/data/logical.db inside the app directory.
LOGICAL_DATA_DIR=./server/data

# Optional: set an exact database file instead of a directory.
# LOGICAL_DB=/var/lib/logical/logical.db
